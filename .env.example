HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
GITHUB_TOKEN=replace-with-your-personal-access-token
# Required allowlist. Comma-separated owner/repository names.
GITHUB_REPOSITORIES=your-user/your-repository

# ollama | openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_MODEL=gpt-4.1-mini
# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=

MAX_DIFF_CHARS=60000
MAX_FILE_CHARS=12000
MAX_FILES=40
MAX_QUEUE_SIZE=10
REVIEW_TIMEOUT_MS=180000
MAX_OUTPUT_TOKENS=3000
