{
  "name": "mastra-pr-reviewer",
  "version": "0.1.0",
  "license": "ISC",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "start:container": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "node --import tsx --test src/**/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.71",
    "@mastra/core": "1.82.0",
    "@octokit/rest": "^22.0.1",
    "fastify": "^5.6.2",
    "ollama-ai-provider": "1.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
